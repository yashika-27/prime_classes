carc_pattern = df.groupby(
    ['cp_PayerName', 'cd_ProcedureCode']
)['is_denied'].mean().reset_index()

carc_pattern.rename(columns={'is_denied': 'denial_rate'}, inplace=True)


df = df.merge(
    carc_pattern,
    on=['cp_PayerName', 'cd_ProcedureCode'],
    how='left'
)


df


features = df[['pcla_AdjustmentAmount', 'denial_rate']]


from sklearn.preprocessing import StandardScaler

scaler = StandardScaler()
scaled_features = scaler.fit_transform(features)





from sklearn.cluster import KMeans

kmeans = KMeans(n_clusters=3, random_state=42)
df['cluster'] = kmeans.fit_predict(scaled_features)


df.groupby('cluster')[['pcla_AdjustmentAmount','denial_rate']].mean()


def label_cluster(row):
    amount = row['pcla_AdjustmentAmount']
    rate = row['denial_rate']

    if amount > 8000 and rate < 0.3:
        return "High Value - Low Risk"

    elif amount > 8000 and rate <= 0.6:
        return "High Value - Medium Risk (Focus)"

    elif rate > 0.8:
        return "High Risk - Likely Not Recoverable"

    elif amount < 1000:
        return "Low Value - Low Priority"

    else:
        return "Medium Priority"


